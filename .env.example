ANTHROPIC_API_KEY=
# API key from https://www.thenewsapi.com
THENEWSAPI_KEY=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
DATABASE_URL=postgresql://digest:digest@localhost:5432/good_news_digest
DIGEST_RECIPIENT_EMAIL=
SIMILARITY_THRESHOLD=0.85
SENTIMENT_THRESHOLD=0.6
# Prefer scores near this value (Glass tone). Leave empty for max-positive ranking.
# SENTIMENT_TARGET=0.65
DIGEST_SIZE=5
TOPIC_DIVERSITY_THRESHOLD=0.70
DIGEST_HOUR=7
DIGEST_TIMEZONE=America/Los_Angeles
FETCH_WINDOW_HOURS=24
# Dev/test only — enables DELETE /digest to unlock recompile+resend same day
ALLOW_DIGEST_RESET=false
# Optional — public HTTPS URL for email header banner (unused until re-enabled)
DIGEST_BANNER_URL=
